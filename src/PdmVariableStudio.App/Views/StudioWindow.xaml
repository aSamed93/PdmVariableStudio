<Window x:Class="PdmVariableStudio.App.Views.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PdmVariableStudio.App.Views"
        Title="PDM Variable Studio"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource Surface.Background}">

    <Window.Resources>
        <!--
            Tema BURADA birleştirilmiyor; Program.cs içinde Application kapsamına ekleniyor.
            Gerekçe orada yazılı: durum renklerini çalışma anında çözen dönüştürücü yalnızca
            Application.Resources içine bakabiliyor. StaticResource aramaları pencereden
            uygulamaya doğru yürüdüğü için buradaki stiller yine çözülüyor.
        -->
        <ResourceDictionary>
            <views:StatusBrushConverter x:Key="StatusBrush" />
            <views:CountToVisibilityConverter x:Key="CountToVisibility" />
            <views:TextToVisibilityConverter x:Key="TextToVisibility" />
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Durum hücresi: renk + simge + metin birlikte. -->
            <DataTemplate x:Key="StatusCell">
                <Border Style="{StaticResource StatusBadge}"
                        Background="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                        ToolTip="{Binding Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusGlyph}"
                                   FontSize="12"
                                   Margin="0,0,5,0"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ üst bilgi ============================ -->
        <Border Grid.Row="0" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
            <DockPanel>
                <Button Content="Hakkında"
                        Command="{Binding ShowAboutCommand}"
                        DockPanel.Dock="Right"
                        MinWidth="0"
                        Margin="0"
                        ToolTip="Sürüm, günlük ve işlem geçmişi konumları, destek bağlantıları" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vault:" Style="{StaticResource Text.Muted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold" Margin="0,0,20,0" />
                    <TextBlock Text="Klasör:" Style="{StaticResource Text.Muted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding FolderPath}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ sekmeler ============================ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Surface.Border}">

            <!-- ===== DIŞA AKTAR ===== -->
            <TabItem Header="Dışa Aktar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- kaynak düğmeleri: satır 0 -->
                        <RowDefinition Height="Auto" />
                        <!-- dosya listesi: ana alan -->
                        <RowDefinition Height="3*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <!-- değişken listesi: daraltıldı -->
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- kaynaklar -->
                    <Border Grid.Row="0" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="Klasör Ekle…"
                                        Command="{Binding AddFolderCommand}"
                                        ToolTip="Bir klasördeki dosyaları listeye ekler" />
                                <Button Content="Dosya Ekle…"
                                        Command="{Binding AddFilesCommand}"
                                        ToolTip="PDM'in dosya seçme penceresinden tek tek dosya ekler" />
                                <Button Content="Ara ve Ekle…"
                                        Command="{Binding SearchAndAddCommand}"
                                        ToolTip="Dosya adı ya da kart değerine göre arayıp sonuçları ekler" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="Alt klasörler"
                                          IsChecked="{Binding IncludeSubfolders}"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          ToolTip="Klasör eklerken alt klasörlere de inilsin mi. Varsayılan kapalı." />
                                <Button Content="Seçilenleri Sil" Command="{Binding RemoveSelectedFilesCommand}" MinWidth="0" />
                                <Button Content="Listeyi Temizle" Command="{Binding ClearFilesCommand}" MinWidth="0" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- işleme alınacak dosyalar -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Sil" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" Margin="0"
                                                  ToolTip="İşaretlenenler 'Seçilenleri Sil' ile listeden çıkarılır" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="Klasör" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Tür" Binding="{Binding TypeText}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="Kaynak" Binding="{Binding SourceText}" Width="110" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding FileCountText}"
                               Style="{StaticResource Text.Muted}"
                               Margin="2,6,0,12" />

                    <!-- değişkenler -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Dışa aktarılacak değişkenler"
                                       Style="{StaticResource Text.Heading}"
                                       Margin="0"
                                       DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Tümünü seç" Command="{Binding SelectAllVariablesCommand}" MinWidth="0" />
                                <Button Content="Tümünü temizle" Command="{Binding DeselectAllVariablesCommand}" MinWidth="0" Margin="0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Surface.Border}" BorderThickness="1" CornerRadius="4">
                            <ListBox ItemsSource="{Binding Variables}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <Button Content="Dışa Aktar…"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ExportCommand}"
                                DockPanel.Dock="Right"
                                Margin="0" />

                        <!-- Son dışa aktarım: kullanıcı Excel'e hemen geçebilsin diye.
                             Yalnızca bu oturumda bir dosya yazıldıysa görünür. -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LastExportPath, Converter={StaticResource TextToVisibility}}">
                            <TextBlock Text="{Binding LastExportFileName}"
                                       ToolTip="{Binding LastExportPath}"
                                       Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260"
                                       Margin="0,0,8,0" />
                            <Button Content="Excel'de Aç"
                                    Command="{Binding OpenLastExportCommand}"
                                    ToolTip="Son dışa aktarılan çalışma kitabını varsayılan uygulamada açar"
                                    Margin="0,0,6,0" />
                            <Button Content="Klasörü Göster"
                                    Command="{Binding RevealLastExportCommand}"
                                    ToolTip="Dosyayı Windows Gezgini'nde seçili gösterir"
                                    Margin="0,0,12,0" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== İÇE AKTAR ===== -->
            <TabItem Header="İçe Aktar">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- dosya seçimi + özet -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Çalışma kitabı seç…"
                                Command="{Binding ImportCommand}"
                                DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding WorkbookPath}"
                                   Style="{StaticResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,0,0" />
                    </DockPanel>

                    <!-- reddedildi şeridi -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Danger.Background}"
                            BorderBrush="{StaticResource Danger.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsRejected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✗" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{StaticResource Danger.Foreground}" />
                            <TextBlock Text="{Binding RejectionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Danger.Foreground}" />
                        </StackPanel>
                    </Border>

                    <!-- özet + süzgeçler -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding HasChangeSet, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Safe.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Safe.Foreground}">
                                    <Run Text="✓" /><Run Text=" " /><Run Text="{Binding SafeChangeCount, Mode=OneWay}" /><Run Text=" güvenli değişiklik" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Conflict.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Conflict.Foreground}">
                                    <Run Text="⚠" /><Run Text=" " /><Run Text="{Binding ConflictCount, Mode=OneWay}" /><Run Text=" çakışma" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Error.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Error.Foreground}">
                                    <Run Text="✗" /><Run Text=" " /><Run Text="{Binding ErrorCount, Mode=OneWay}" /><Run Text=" hata" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Blocked.Background}">
                                <TextBlock Foreground="{StaticResource Status.Blocked.Foreground}">
                                    <Run Text="·" /><Run Text=" " /><Run Text="{Binding UnchangedCount, Mode=OneWay}" /><Run Text=" değişmemiş" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <CheckBox Content="Yalnızca değişenler" IsChecked="{Binding ShowChangesOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="Çakışmalar" IsChecked="{Binding ShowConflictsOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="Hatalar" IsChecked="{Binding ShowErrorsOnly}" Margin="0,0,20,0" />
                                <Button Content="Güvenli olanları seç" Command="{Binding SelectAllSafeCommand}" MinWidth="0" />
                                <Button Content="Seçimi temizle" Command="{Binding DeselectAllCommand}" MinWidth="0" />
                            </StackPanel>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     MinWidth="180"
                                     HorizontalAlignment="Right"
                                     ToolTip="Dosya adı, değişken ya da değere göre süz" />
                        </DockPanel>
                    </StackPanel>

                    <!-- önizleme tablosu -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ChangesView}"
                              IsReadOnly="False"
                              SelectionChanged="OnChangeSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Uygula" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0"
                                                  Checked="OnRowCheckChanged"
                                                  Unchecked="OnRowCheckChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Durum" Width="150" CellTemplate="{StaticResource StatusCell}" />

                            <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="Klasör" Binding="{Binding RelativePath}" Width="150" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Konfig."
                                               ToolTip="&quot;@&quot; = konfigürasyondan bağımsız, dosya düzeyindeki değer (SOLIDWORKS Custom sekmesi).&#x0a;Adlandırılmış konfigürasyonlar ayrı satırlardır ve PDM kartında ayrı tutulur." />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Configuration}" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Değişken" Binding="{Binding VariableName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Dışa aktarımdaki" Binding="{Binding OriginalValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="PDM'deki güncel" Binding="{Binding CurrentValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Excel'deki yeni" Binding="{Binding RequestedValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Neden" Binding="{Binding Reason}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- check-out onayı + uygula -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0"
                                Visibility="{Binding HasChangeSet, Converter={StaticResource BoolToVisibility}}">

                        <Border Background="{StaticResource Warning.Background}"
                                BorderBrush="{StaticResource Warning.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,8"
                                Visibility="{Binding PendingCheckoutCount, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{StaticResource Warning.Foreground}" />
                                    <TextBlock Text="{Binding CheckoutWarning}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Warning.Foreground}" />
                                </StackPanel>

                                <CheckBox Content="Anladım, dosyalar check-out edilsin"
                                          IsChecked="{Binding CheckoutConsent}"
                                          Foreground="{StaticResource Warning.Foreground}" />

                                <CheckBox Content="İşlem sonunda bizim çektiğimiz dosyalar check-in edilsin (yeni sürüm üretir)"
                                          IsChecked="{Binding CheckInAfterApply}"
                                          Foreground="{StaticResource Warning.Foreground}" />

                                <TextBox Text="{Binding CheckInComment, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="22,4,0,0"
                                         Visibility="{Binding CheckInAfterApply, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="Check-in yorumu" />
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Muted}">
                                <Run Text="Seçili:" /><Run Text=" " /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=" hücre" />
                            </TextBlock>
                            <Button Content="Uygula"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding ApplyCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== GEÇMİŞ ===== -->
            <TabItem Header="İşlem Geçmişi">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="Son işlemler" Style="{StaticResource Text.Heading}" DockPanel.Dock="Left" />
                        <Button Content="Yenile" Command="{Binding RefreshOperationsCommand}"
                                HorizontalAlignment="Right" MinWidth="0" Margin="0" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Operations}"
                              SelectedItem="{Binding SelectedOperation}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tarih" Binding="{Binding Timestamp}" Width="130" />
                            <DataGridTextColumn Header="Tür" Binding="{Binding TypeText}" Width="90" />
                            <DataGridTextColumn Header="Kullanıcı" Binding="{Binding User}" Width="120" />
                            <DataGridTextColumn Header="Kapsam" Binding="{Binding Summary}" Width="150" />
                            <DataGridTextColumn Header="Kaynak" Binding="{Binding Workbook}" Width="180" />
                            <DataGridTextColumn Header="Sonuç" Binding="{Binding OutcomeText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,6">
                        <TextBlock Text="Geri alma önizlemesi" Style="{StaticResource Text.Heading}" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding HasUndoPreview, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Safe.Background}" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource Status.Safe.Foreground}">
                                    <Run Text="✓" /><Run Text=" " /><Run Text="{Binding UndoSafeCount, Mode=OneWay}" /><Run Text=" güvenli" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Conflict.Background}" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource Status.Conflict.Foreground}">
                                    <Run Text="⚠" /><Run Text=" " /><Run Text="{Binding UndoConflictCount, Mode=OneWay}" /><Run Text=" çakışma" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Blocked.Background}">
                                <TextBlock Foreground="{StaticResource Status.Blocked.Foreground}">
                                    <Run Text="🔒" /><Run Text=" " /><Run Text="{Binding UndoUnavailableCount, Mode=OneWay}" /><Run Text=" kullanılamaz" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding UndoRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Geri al" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" Margin="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Durum" Width="150" CellTemplate="{StaticResource StatusCell}" />

                            <DataGridTextColumn Header="Dosya" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="Konfig."
                                               ToolTip="&quot;@&quot; = konfigürasyondan bağımsız, dosya düzeyindeki değer (SOLIDWORKS Custom sekmesi).&#x0a;Adlandırılmış konfigürasyonlar ayrı satırlardır ve PDM kartında ayrı tutulur." />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Configuration}" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Değişken" Binding="{Binding VariableName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Uyguladığımız" Binding="{Binding AppliedValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="PDM'deki güncel" Binding="{Binding CurrentValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Geri alınca" Binding="{Binding ValueAfterUndo}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="Açıklama" Binding="{Binding Tooltip}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Geri alma önizlemesi" Command="{Binding PreviewUndoCommand}" />
                        <Button Content="Geri Al"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ApplyUndoCommand}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================ durum çubuğu ============================ -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,10,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Text.Muted}" Margin="0,0,10,0" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="Durdur" Command="{Binding CancelCommand}" MinWidth="0" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
