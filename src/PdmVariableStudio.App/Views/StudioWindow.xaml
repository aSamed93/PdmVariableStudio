<Window x:Class="PdmVariableStudio.App.Views.StudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PdmVariableStudio.App.Views"
        Title="PDM Variable Studio"
        Height="720" Width="1180"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="{DynamicResource Surface.Background}">

    <Window.Resources>
        <!--
            Tema BURADA birleştirilmiyor; Program.cs içinde Application kapsamına ekleniyor.
            Gerekçe orada yazılı: durum renklerini çalışma anında çözen dönüştürücü yalnızca
            Application.Resources içine bakabiliyor. StaticResource aramaları pencereden
            uygulamaya doğru yürüdüğü için buradaki stiller yine çözülüyor.
        -->
        <ResourceDictionary>
            <views:StatusBrushConverter x:Key="StatusBrush" />
            <views:CountToVisibilityConverter x:Key="CountToVisibility" />
            <views:TextToVisibilityConverter x:Key="TextToVisibility" />
            <views:CountNounConverter x:Key="CountNoun" />
            <views:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Durum hücresi: renk + simge + metin birlikte. -->
            <DataTemplate x:Key="StatusCell">
                <Border Style="{StaticResource StatusBadge}"
                        Background="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Background}"
                        ToolTip="{Binding Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusGlyph}"
                                   FontSize="12"
                                   Margin="0,0,5,0"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{Binding StatusKind, Converter={StaticResource StatusBrush}, ConverterParameter=Foreground}" />
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ üst bilgi ============================ -->
        <Border Grid.Row="0" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
            <DockPanel>
                <Button Content="{views:T 'Hakkında', 'About'}"
                        Command="{Binding ShowAboutCommand}"
                        DockPanel.Dock="Right"
                        MinWidth="0"
                        Margin="0"
                        ToolTip="{views:T 'Sürüm, günlük ve işlem geçmişi konumları, destek bağlantıları', 'Version, log and operation history locations, support links'}" />
                <!-- Dil seçimi: HKCU'ya yazılır, yeniden başlatınca geçerli olur (StudioWindow.xaml.cs). -->
                <ComboBox x:Name="LanguagePicker"
                          DockPanel.Dock="Right"
                          VerticalAlignment="Center"
                          MinWidth="90"
                          Margin="0,0,8,0"
                          SelectionChanged="OnLanguageChanged"
                          ToolTip="{views:T 'Arayüz dili', 'Interface language'}">
                    <ComboBoxItem Content="Türkçe" Tag="tr" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Vault:" Style="{StaticResource Text.Muted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding VaultName}" FontWeight="SemiBold" Margin="0,0,20,0" />
                    <TextBlock Text="{views:T 'Klasör:', 'Folder:'}" Style="{StaticResource Text.Muted}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding FolderPath}" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================ sekmeler ============================ -->
        <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{StaticResource Surface.Border}">

            <!-- ===== DIŞA AKTAR ===== -->
            <TabItem Header="{views:T 'Dışa Aktar', 'Export'}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <!-- kaynak düğmeleri: satır 0 -->
                        <RowDefinition Height="Auto" />
                        <!-- dosya listesi: ana alan -->
                        <RowDefinition Height="3*" MinHeight="160" />
                        <RowDefinition Height="Auto" />
                        <!-- değişken listesi: daraltıldı -->
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- kaynaklar -->
                    <Border Grid.Row="0" Style="{StaticResource Panel.Card}" Margin="0,0,0,10">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <Button Content="{views:T 'Klasör Ekle…', 'Add Folder…'}"
                                        Command="{Binding AddFolderCommand}"
                                        ToolTip="{views:T 'Bir klasördeki dosyaları listeye ekler', 'Adds the files in a folder to the list'}" />
                                <Button Content="{views:T 'Dosya Ekle…', 'Add Files…'}"
                                        Command="{Binding AddFilesCommand}"
                                        ToolTip="{views:T 'PDM\'in dosya seçme penceresinden tek tek dosya ekler', 'Adds individual files from the PDM file picker'}" />
                                <Button Content="{views:T 'Ara ve Ekle…', 'Search and Add…'}"
                                        Command="{Binding SearchAndAddCommand}"
                                        ToolTip="{views:T 'Dosya adı ya da kart değerine göre arayıp sonuçları ekler', 'Searches by file name or data card value and adds the results'}" />
                                <Button Content="{views:T 'Montajdan Ekle…', 'Add from Assembly…'}"
                                        Command="{Binding AddFromAssemblyCommand}"
                                        ToolTip="{views:T 'Bir montajın tüm bileşenlerini, montajın kullandığı konfigürasyonlarla ekler', 'Adds all components of an assembly, with the configurations the assembly uses'}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="{views:T 'Alt klasörler', 'Subfolders'}"
                                          IsChecked="{Binding IncludeSubfolders}"
                                          Margin="0,0,14,0"
                                          VerticalAlignment="Center"
                                          ToolTip="{views:T 'Klasör eklerken alt klasörlere de inilsin mi. Varsayılan kapalı.', 'Whether to include subfolders when adding a folder. Off by default.'}" />
                                <Button Content="{views:T 'Seçilenleri Sil', 'Remove Selected'}" Command="{Binding RemoveSelectedFilesCommand}" MinWidth="0" />
                                <Button Content="{views:T 'Listeyi Temizle', 'Clear List'}" Command="{Binding ClearFilesCommand}" MinWidth="0" Margin="0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- işleme alınacak dosyalar -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Files}" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{views:T 'Sil', 'Remove'}" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" Margin="0"
                                                  ToolTip="{views:T 'İşaretlenenler \'Seçilenleri Sil\' ile listeden çıkarılır', 'Checked files are removed from the list with \'Remove Selected\''}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="{views:T 'Dosya', 'File'}" Binding="{Binding FileName}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Klasör', 'Folder'}" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Tür', 'Type'}" Binding="{Binding TypeText}" Width="110" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Kaynak', 'Source'}" Binding="{Binding SourceText}" Width="110" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                        <Setter Property="ToolTip" Value="{Binding SourceToolTip}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2"
                               Text="{Binding FileCountText}"
                               Style="{StaticResource Text.Muted}"
                               Margin="2,6,0,12" />

                    <!-- değişkenler -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="{views:T 'Dışa aktarılacak değişkenler', 'Variables to export'}"
                                       Style="{StaticResource Text.Heading}"
                                       Margin="0"
                                       DockPanel.Dock="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{views:T 'Tümünü seç', 'Select all'}" Command="{Binding SelectAllVariablesCommand}" MinWidth="0" />
                                <Button Content="{views:T 'Tümünü temizle', 'Clear all'}" Command="{Binding DeselectAllVariablesCommand}" MinWidth="0" Margin="0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" BorderBrush="{StaticResource Surface.Border}" BorderThickness="1" CornerRadius="4">
                            <ListBox ItemsSource="{Binding Variables}"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,12,0,0">
                        <Button Content="{views:T 'Dışa Aktar…', 'Export…'}"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ExportCommand}"
                                DockPanel.Dock="Right"
                                Margin="0" />

                        <!-- Son dışa aktarım: kullanıcı Excel'e hemen geçebilsin diye.
                             Yalnızca bu oturumda bir dosya yazıldıysa görünür. -->
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding LastExportPath, Converter={StaticResource TextToVisibility}}">
                            <TextBlock Text="{Binding LastExportFileName}"
                                       ToolTip="{Binding LastExportPath}"
                                       Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="260"
                                       Margin="0,0,8,0" />
                            <Button Content="{views:T 'Excel\'de Aç', 'Open in Excel'}"
                                    Command="{Binding OpenLastExportCommand}"
                                    ToolTip="{views:T 'Son dışa aktarılan çalışma kitabını varsayılan uygulamada açar', 'Opens the last exported workbook in the default application'}"
                                    Margin="0,0,6,0" />
                            <Button Content="{views:T 'Klasörü Göster', 'Show in Folder'}"
                                    Command="{Binding RevealLastExportCommand}"
                                    ToolTip="{views:T 'Dosyayı Windows Gezgini\'nde seçili gösterir', 'Shows the file selected in Windows Explorer'}"
                                    Margin="0,0,12,0" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ===== İÇE AKTAR ===== -->
            <TabItem Header="{views:T 'İçe Aktar', 'Import'}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- dosya seçimi + özet -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="{views:T 'Çalışma kitabı seç…', 'Select workbook…'}"
                                Command="{Binding ImportCommand}"
                                DockPanel.Dock="Left" />
                        <TextBlock Text="{Binding WorkbookPath}"
                                   Style="{StaticResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="6,0,0,0" />
                    </DockPanel>

                    <!-- reddedildi şeridi -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Danger.Background}"
                            BorderBrush="{StaticResource Danger.Border}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,10"
                            Visibility="{Binding IsRejected, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✗" FontSize="14" Margin="0,0,8,0"
                                       Foreground="{StaticResource Danger.Foreground}" />
                            <TextBlock Text="{Binding RejectionMessage}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Danger.Foreground}" />
                        </StackPanel>
                    </Border>

                    <!-- özet + süzgeçler -->
                    <StackPanel Grid.Row="2"
                                Visibility="{Binding HasChangeSet, Converter={StaticResource BoolToVisibility}}">
                        <WrapPanel Margin="0,0,0,8">
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Safe.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Safe.Foreground}">
                                    <Run Text="✓" /><Run Text=" " /><Run Text="{Binding SafeChangeCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='güvenli değişiklik|safe change|safe changes'}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Conflict.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Conflict.Foreground}">
                                    <Run Text="⚠" /><Run Text=" " /><Run Text="{Binding ConflictCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='çakışma|conflict|conflicts'}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Error.Background}" Margin="0,0,8,0">
                                <TextBlock Foreground="{StaticResource Status.Error.Foreground}">
                                    <Run Text="✗" /><Run Text=" " /><Run Text="{Binding ErrorCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='hata|error|errors'}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Blocked.Background}">
                                <TextBlock Foreground="{StaticResource Status.Blocked.Foreground}">
                                    <Run Text="·" /><Run Text=" " /><Run Text="{Binding UnchangedCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='değişmemiş|unchanged|unchanged'}" />
                                </TextBlock>
                            </Border>
                        </WrapPanel>

                        <DockPanel Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                <CheckBox Content="{views:T 'Yalnızca değişenler', 'Changes only'}" IsChecked="{Binding ShowChangesOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="{views:T 'Çakışmalar', 'Conflicts'}" IsChecked="{Binding ShowConflictsOnly}" Margin="0,0,14,0" />
                                <CheckBox Content="{views:T 'Hatalar', 'Errors'}" IsChecked="{Binding ShowErrorsOnly}" Margin="0,0,20,0" />
                                <Button Content="{views:T 'Güvenli olanları seç', 'Select safe changes'}" Command="{Binding SelectAllSafeCommand}" MinWidth="0" />
                                <Button Content="{views:T 'Seçimi temizle', 'Clear selection'}" Command="{Binding DeselectAllCommand}" MinWidth="0" />
                            </StackPanel>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                     MinWidth="180"
                                     HorizontalAlignment="Right"
                                     ToolTip="{views:T 'Dosya adı, değişken ya da değere göre süz', 'Filter by file name, variable or value'}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- önizleme tablosu -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ChangesView}"
                              IsReadOnly="False"
                              SelectionChanged="OnChangeSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{views:T 'Uygula', 'Apply'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center"
                                                  Margin="0"
                                                  Checked="OnRowCheckChanged"
                                                  Unchecked="OnRowCheckChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{views:T 'Durum', 'Status'}" Width="150" CellTemplate="{StaticResource StatusCell}" />

                            <DataGridTextColumn Header="{views:T 'Dosya', 'File'}" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Klasör', 'Folder'}" Binding="{Binding RelativePath}" Width="150" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{views:T 'Konfig.', 'Config.'}"
                                               ToolTip="{views:T '&quot;@&quot; = konfigürasyondan bağımsız, dosya düzeyindeki değer (SOLIDWORKS Custom sekmesi).&#x0a;Adlandırılmış konfigürasyonlar ayrı satırlardır ve PDM kartında ayrı tutulur.', '&quot;@&quot; = configuration-independent, file-level value (SOLIDWORKS Custom tab).&#x0a;Named configurations are separate rows and are stored separately on the PDM data card.'}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Configuration}" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{views:T 'Değişken', 'Variable'}" Binding="{Binding VariableName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Dışa aktarımdaki', 'At export'}" Binding="{Binding OriginalValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'PDM\'deki güncel', 'Current in PDM'}" Binding="{Binding CurrentValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Excel\'deki yeni', 'New in Excel'}" Binding="{Binding RequestedValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Neden', 'Reason'}" Binding="{Binding Reason}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- check-out onayı + uygula -->
                    <StackPanel Grid.Row="4" Margin="0,10,0,0"
                                Visibility="{Binding HasChangeSet, Converter={StaticResource BoolToVisibility}}">

                        <Border Background="{StaticResource Warning.Background}"
                                BorderBrush="{StaticResource Warning.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,8"
                                Visibility="{Binding PendingCheckoutCount, Converter={StaticResource CountToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0"
                                               Foreground="{StaticResource Warning.Foreground}" />
                                    <TextBlock Text="{Binding CheckoutWarning}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Warning.Foreground}" />
                                </StackPanel>

                                <CheckBox Content="{views:T 'Anladım, dosyalar check-out edilsin', 'I understand, check out the files'}"
                                          IsChecked="{Binding CheckoutConsent}"
                                          Foreground="{StaticResource Warning.Foreground}" />

                                <CheckBox Content="{views:T 'İşlem sonunda bizim çektiğimiz dosyalar check-in edilsin (yeni sürüm üretir)', 'Check in the files we checked out when finished (creates a new version)'}"
                                          IsChecked="{Binding CheckInAfterApply}"
                                          Foreground="{StaticResource Warning.Foreground}" />

                                <TextBox Text="{Binding CheckInComment, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="22,4,0,0"
                                         Visibility="{Binding CheckInAfterApply, Converter={StaticResource BoolToVisibility}}"
                                         ToolTip="{views:T 'Check-in yorumu', 'Check-in comment'}" />
                            </StackPanel>
                        </Border>

                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Muted}">
                                <Run Text="{views:T 'Seçili:', 'Selected:'}" /><Run Text=" " /><Run Text="{Binding SelectedCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='hücre|cell|cells'}" />
                            </TextBlock>
                            <Button Content="{views:T 'Uygula', 'Apply'}"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding ApplyCommand}"
                                    HorizontalAlignment="Right"
                                    Margin="0" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ===== GEÇMİŞ ===== -->
            <TabItem Header="{views:T 'İşlem Geçmişi', 'Operation History'}">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{views:T 'Son işlemler', 'Recent operations'}" Style="{StaticResource Text.Heading}" DockPanel.Dock="Left" />
                        <Button Content="{views:T 'Yenile', 'Refresh'}" Command="{Binding RefreshOperationsCommand}"
                                HorizontalAlignment="Right" MinWidth="0" Margin="0" />
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Operations}"
                              SelectedItem="{Binding SelectedOperation}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{views:T 'Tarih', 'Date'}" Binding="{Binding Timestamp}" Width="130" />
                            <DataGridTextColumn Header="{views:T 'Tür', 'Type'}" Binding="{Binding TypeText}" Width="90" />
                            <DataGridTextColumn Header="{views:T 'Kullanıcı', 'User'}" Binding="{Binding User}" Width="120" />
                            <DataGridTextColumn Header="{views:T 'Kapsam', 'Scope'}" Binding="{Binding Summary}" Width="150" />
                            <DataGridTextColumn Header="{views:T 'Kaynak', 'Source'}" Binding="{Binding Workbook}" Width="180" />
                            <DataGridTextColumn Header="{views:T 'Sonuç', 'Result'}" Binding="{Binding OutcomeText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <DockPanel Grid.Row="2" Margin="0,10,0,6">
                        <TextBlock Text="{views:T 'Geri alma önizlemesi', 'Undo preview'}" Style="{StaticResource Text.Heading}" DockPanel.Dock="Left" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding HasUndoPreview, Converter={StaticResource BoolToVisibility}}">
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Safe.Background}" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource Status.Safe.Foreground}">
                                    <Run Text="✓" /><Run Text=" " /><Run Text="{Binding UndoSafeCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='güvenli|safe|safe'}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Conflict.Background}" Margin="0,0,6,0">
                                <TextBlock Foreground="{StaticResource Status.Conflict.Foreground}">
                                    <Run Text="⚠" /><Run Text=" " /><Run Text="{Binding UndoConflictCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='çakışma|conflict|conflicts'}" />
                                </TextBlock>
                            </Border>
                            <Border Style="{StaticResource StatusBadge}" Background="{StaticResource Status.Blocked.Background}">
                                <TextBlock Foreground="{StaticResource Status.Blocked.Foreground}">
                                    <Run Text="🔒" /><Run Text=" " /><Run Text="{Binding UndoUnavailableCount, Mode=OneWay, Converter={StaticResource CountNoun}, ConverterParameter='kullanılamaz|unavailable|unavailable'}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </DockPanel>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding UndoRows}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{views:T 'Geri al', 'Undo'}" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  HorizontalAlignment="Center" Margin="0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{views:T 'Durum', 'Status'}" Width="150" CellTemplate="{StaticResource StatusCell}" />

                            <DataGridTextColumn Header="{views:T 'Dosya', 'File'}" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{views:T 'Konfig.', 'Config.'}"
                                               ToolTip="{views:T '&quot;@&quot; = konfigürasyondan bağımsız, dosya düzeyindeki değer (SOLIDWORKS Custom sekmesi).&#x0a;Adlandırılmış konfigürasyonlar ayrı satırlardır ve PDM kartında ayrı tutulur.', '&quot;@&quot; = configuration-independent, file-level value (SOLIDWORKS Custom tab).&#x0a;Named configurations are separate rows and are stored separately on the PDM data card.'}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Configuration}" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{views:T 'Değişken', 'Variable'}" Binding="{Binding VariableName}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Uyguladığımız', 'Applied value'}" Binding="{Binding AppliedValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'PDM\'deki güncel', 'Current in PDM'}" Binding="{Binding CurrentValue}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Geri alınca', 'After undo'}" Binding="{Binding ValueAfterUndo}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="{views:T 'Açıklama', 'Details'}" Binding="{Binding Tooltip}" Width="*" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="{views:T 'Geri alma önizlemesi', 'Preview undo'}" Command="{Binding PreviewUndoCommand}" />
                        <Button Content="{views:T 'Geri Al', 'Undo'}"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding ApplyUndoCommand}"
                                Margin="0" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ============================ durum çubuğu ============================ -->
        <Border Grid.Row="2" Style="{StaticResource Panel.Card}" Margin="0,10,0,0" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Text.Muted}" Margin="0,0,10,0" />
                    <ProgressBar IsIndeterminate="True" Width="120" Height="6" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Content="{views:T 'Durdur', 'Stop'}" Command="{Binding CancelCommand}" MinWidth="0" Margin="0" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
